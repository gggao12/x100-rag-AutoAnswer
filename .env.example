DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MCP_ENABLED=1
MCP_TRANSPORT=stdio
MCP_SERVER_MODULE=server.mcp_server
MCP_STARTUP_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_SECONDS=20
MAX_AGENT_STEPS=4
MAX_TOOL_CALLS=3

# Optional local MySQL order store
X100_MYSQL_ENABLED=1
X100_MYSQL_HOST=127.0.0.1
X100_MYSQL_PORT=3306
X100_MYSQL_USER=root
X100_MYSQL_PASSWORD=
X100_MYSQL_DATABASE=x100_demo

